# ==========================================================
# PORTFOLIO PROJECT MANAGER - SERVER ENVIRONMENT
# Copy this file to `.env` and fill in real values.
# NEVER commit the real `.env` file.
# ==========================================================

# --- Server ---
NODE_ENV=development
PORT=4000

# Comma-separated list of origins allowed to call the API.
# In production set this to your real site URL.
CLIENT_ORIGIN=http://localhost:5173

# Where the built client lives. Served automatically when it exists.
SERVE_CLIENT=true

# Mount the admin surface (login, project mutations, uploads)?
#
#   true  -> this process is your Project Manager CMS. Keep it on your machine.
#   false -> public-only deployment. /api/auth/* and every write route are then
#            absent from the build, not merely PIN-protected.
#
# The public deployment on Vercel sets this to false. You publish by editing in
# the local CMS, which writes to the same database the public API reads.
EXPOSE_ADMIN=true

# --- Database ---
# `sqlite` for local development, `postgres` for production.
DB_CLIENT=sqlite

# Used when DB_CLIENT=sqlite (relative paths resolve from the server/ folder)
SQLITE_FILE=./data/portfolio.db

# Used when DB_CLIENT=postgres
#
# On a serverless host use the TRANSACTION POOLER, not the direct connection.
# In Supabase: Project Settings > Database > Connection string > "Session pooler"
# (port 6543) and append ?pgbouncer=true. The direct URL (port 5432) will run
# out of connections once Vercel spins up more than a handful of lambdas.
#
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true

# --- Admin authentication ---
# The PIN is NEVER sent to the browser and never stored in React code.
#
# Preferred: store a bcrypt hash. Generate one with:
#     npm run pin:hash
# then paste the result below.
ADMIN_PIN_HASH=

# Convenience for first-time setup only. If ADMIN_PIN_HASH is empty and
# ADMIN_PIN is present, the server hashes it once at boot, prints a warning,
# and then ignores the plaintext value for the rest of the process lifetime.
# Leave ADMIN_PIN empty in production.
ADMIN_PIN=

# Session cookie lifetime in hours.
SESSION_TTL_HOURS=12

# Set to "true" when serving over HTTPS so the cookie gets the Secure flag.
# Auto-detected from NODE_ENV=production unless explicitly overridden.
COOKIE_SECURE=auto

# --- Login rate limiting ---
LOGIN_WINDOW_MINUTES=15
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# --- File storage ---
# `local`   -> writes into server/uploads and serves from /uploads
# `supabase`-> Supabase Storage (uses REST, no extra npm package)
# `s3`      -> AWS S3 / Cloudflare R2 (requires @aws-sdk/client-s3)
STORAGE_DRIVER=local

# Max upload size in megabytes (applies to every image).
MAX_UPLOAD_MB=8

# Max number of gallery images accepted in one upload request.
MAX_GALLERY_IMAGES=8

# Comma-separated MIME types + extensions that are accepted.
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# --- local driver ---
UPLOAD_DIR=./uploads
PUBLIC_UPLOAD_PATH=/uploads

# --- supabase driver ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=portfolio

# --- s3 driver ---
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=