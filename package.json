{
  "name": "nino-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Portfolio website with a private, PIN-protected Project Manager CMS.",
  "workspaces": [
    "client",
    "Admin-Portfolio",
    "server"
  ],
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "scripts": {
    "dev": "concurrently -n server,client,admin -c cyan,magenta,yellow \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:admin\"",
    "dev:server": "npm run dev -w server",
    "dev:client": "npm run dev -w client",
    "dev:admin": "npm run dev -w Admin-Portfolio",
    "build": "npm run build -w client && npm run build -w Admin-Portfolio",
    "preview": "concurrently -n server,client -c cyan,magenta \"npm:start\" \"npm run preview -w client\"",
    "start": "npm run start -w server",
    "pin:hash": "npm run pin:hash -w server",
    "seed": "npm run seed -w server --"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}